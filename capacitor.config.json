{
  "appId": "co.duna.app",
  "appName": "DUNA",
  "webDir": "docs",
  "android": { "allowMixedContent": false, "backgroundColor": "#F5F1EA" },
  "ios": { "contentInset": "never", "backgroundColor": "#F5F1EA" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 900, "launchAutoHide": true, "backgroundColor": "#F5F1EA", "androidScaleType": "CENTER_CROP", "showSpinner": false },
    "Keyboard": { "resize": "native", "resizeOnFullScreen": true },
    "StatusBar": { "overlaysWebView": false, "style": "LIGHT", "backgroundColor": "#F5F1EA" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
